# Backend environment (Spring Boot reads this from the backend/ directory via dotenv)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the models recorded in DECISIONS.md
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# JWT signing secret (base64-encoded recommended). Override in real use.
JWT_SECRET=change-me-to-a-long-base64-secret

# Local filesystem directory for generated images
UPLOAD_DIR=./uploads