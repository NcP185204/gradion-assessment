package com.gradion.backend.service;

import com.fasterxml.jackson.core.type.TypeReference;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.gradion.backend.model.Character;
import com.gradion.backend.model.Chapter;
import com.gradion.backend.model.PipelineStep;
import com.gradion.backend.model.Project;
import com.gradion.backend.repository.ChapterRepository;
import com.gradion.backend.repository.CharacterRepository;
import com.gradion.backend.repository.PipelineStepRepository;
import com.gradion.backend.repository.ProjectRepository;
import com.gradion.backend.service.gemini.GeminiClient;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.scheduling.annotation.Async;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDateTime;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * Executes a single pipeline step against the real Gemini API, in the
 * background.
 *
 * <p>Mirrors Google's "Book illustration" notebook step for step and keeps the
 * cost rules from the spec:
 *
 * <ul>
 *   <li>The book is uploaded to the File API once ({@code uploadBookText}) and the
 *       resulting file + first interaction id are persisted on the project. Every
 *       later step chains via {@code previous_interaction_id}, so the full text is
 *       never re-sent.</li>
 *   <li>Characters are capped at 2 and chapters at 1 <b>on the server</b> — the
 *       UI cap is not trusted.</li>
 *   <li>Never auto-retries: any failure marks the step FAILED and the user must
 *       explicitly retry that step.</li>
 * </ul>
 *
 * <p>Image interactions update {@code progressJson} as each portrait/illustration
 * lands, so the UI can render individual images instead of one blocking wait.
 */
@Slf4j
@Service
@RequiredArgsConstructor
public class StepRunner {

    // Hard caps per the assessment contract. Enforced server-side, not just in the UI.
    public static final int MAX_CHARACTERS = 2;
    public static final int MAX_CHAPTERS = 1;

    // Negative / system instructions from the notebook.
    private static final String SYSTEM_INSTRUCTIONS = """
            There must be no text on the image, it should not look like a cover page.
            It should be an full illustration with no borders, titles, nor description.
            Unless asked otherwise, stay family-friendly with uplifting colors.
            Each produced should be a simple image, no panels.
            """;

    private final GeminiClient geminiClient;
    private final ProjectRepository projectRepository;
    private final PipelineStepRepository pipelineStepRepository;
    private final CharacterRepository characterRepository;
    private final ChapterRepository chapterRepository;
    private final ImageStorageService imageStorageService;
    private final ObjectMapper objectMapper;

    @Async("stepExecutor")
    public void runStepAsync(Long projectId, int stepNumber, String customStyle) {
        try {
            executeWithErrorHandling(projectId, stepNumber, customStyle);
        } catch (Exception e) {
            log.error("Step {} of project {} failed", stepNumber, projectId, e);
            failStep(projectId, stepNumber, e.getMessage());
        }
    }

    private void executeWithErrorHandling(Long projectId, int stepNumber, String customStyle) {
        PipelineStep step = pipelineStepRepository.findByProjectIdAndStepNumber(projectId, stepNumber)
                .orElseThrow(() -> new IllegalStateException("Step " + stepNumber + " not found for project " + projectId));

        // Guard: if the step is no longer RUNNING (e.g. stuck-reset raced with us),
        // do nothing — the claim in the DB is the source of truth.
        if (!"RUNNING".equals(step.getStatus())) {
            log.warn("Step {} of project {} is {} not RUNNING; skipping async work",
                    stepNumber, projectId, step.getStatus());
            return;
        }

        switch (stepNumber) {
            case 1 -> runStyleStep(projectId, step, customStyle);
            case 2 -> runCharactersStep(projectId, step);
            case 3 -> runPortraitsStep(projectId, step);
            case 4 -> runChaptersStep(projectId, step);
            case 5 -> runIllustrationsStep(projectId, step);
            default -> throw new IllegalStateException("Unknown step number: " + stepNumber);
        }
    }

    // ------------------------------------------------------------------
    // Step 1 — Style
    // ------------------------------------------------------------------

    private void runStyleStep(Long projectId, PipelineStep step, String customStyle) {
        Project project = loadProject(projectId);
        ensureBookUploaded(project);

        GeminiClient.GeminiInteraction styleInteraction;
        if (customStyle != null && !customStyle.isBlank()) {
            styleInteraction = geminiClient.createTextInteraction(
                    "The art style will be: \"" + customStyle + "\". Keep that in mind when generating future prompts. Keep quiet for now, instructions will follow.",
                    project.getBookInteractionId(),
                    null);
        } else {
            styleInteraction = geminiClient.createTextInteraction(
                    "Can you define a art style that would fit the story but with a twist? Just give us the prompt for the art syle that will added to the furture prompts.",
                    project.getBookInteractionId(),
                    null);
        }

        String style = styleInteraction.outputText();
        saveStyle(projectId, styleInteraction.id(), style);

        completeStep(projectId, step.getId(),
                Map.of("style", style),
                "{\"style\": " + jsonString(style) + "}");
    }

    // ------------------------------------------------------------------
    // Step 2 — Characters (structured output, max 2, adults only)
    // ------------------------------------------------------------------

    private void runCharactersStep(Long projectId, PipelineStep step) {
        Project project = loadProject(projectId);
        if (project.getStyleInteractionId() == null) {
            throw new IllegalStateException("Style step has not succeeded; cannot generate characters.");
        }

        String prompt = """
                Can you describe the main characters (only the adults) and prepare a prompt describing them \
                with as much details as possible (use the descriptions from the book) so Nano Banana can \
                generate images of them? Each prompt should be at least 50 words.""";
        GeminiClient.GeminiInteraction interaction = geminiClient.createTextInteraction(
                prompt, project.getStyleInteractionId(), geminiClient.promptArraySchema());

        List<Map<String, String>> parsed = parseNamePromptArray(interaction.outputText());
        // Server-side cap — never trust the UI (or the model) to respect it.
        List<Map<String, String>> capped = parsed.size() > MAX_CHARACTERS
                ? new ArrayList<>(parsed.subList(0, MAX_CHARACTERS))
                : parsed;
        if (capped.isEmpty()) {
            throw new IllegalStateException("Gemini returned no characters.");
        }

        saveCharacters(projectId, interaction.id(), capped);

        completeStep(projectId, step.getId(),
                Map.of("count", capped.size()),
                objectMapper.valueToTree(capped).toString());
    }

    // ------------------------------------------------------------------
    // Step 3 — Portraits (image model, one per character, chained)
    // ------------------------------------------------------------------

    private void runPortraitsStep(Long projectId, PipelineStep step) {
        Project project = loadProject(projectId);
        List<Character> characters = characterRepository.findByProjectIdOrderByDisplayOrder(projectId);
        if (characters.isEmpty()) {
            throw new IllegalStateException("No characters found; run the Characters step first.");
        }
        String style = project.getStyle() == null ? "" : "Follow this style: \"" + project.getStyle() + "\"";

        // Start a fresh image-model conversation (notebook cell 35).
        String setupPrompt = """
                You are going to generate portrait images to illustrate %s.
                %s
                Also follow those rules: %s
                """.formatted(project.getTitle(), style, SYSTEM_INSTRUCTIONS);
        GeminiClient.GeminiInteraction setupInteraction = geminiClient.createImageInteraction(setupPrompt, null);
        String previous = setupInteraction.id();

        int done = 0;
        int total = Math.min(characters.size(), MAX_CHARACTERS);
        for (int i = 0; i < total; i++) {
            Character character = characters.get(i);
            String imagePrompt = """
                    Create an illustration for %s following this description: %s"""
                    .formatted(character.getName(), character.getImagePrompt());
            GeminiClient.GeminiInteraction imageInteraction = geminiClient.createImageInteraction(imagePrompt, previous);
            previous = imageInteraction.id();

            if (imageInteraction.images().isEmpty()) {
                throw new IllegalStateException("Gemini returned no image for " + character.getName());
            }
            GeminiClient.GeminiImage image = imageInteraction.images().get(0);
            String relativePath = imageStorageService.saveImage(projectId, image.data(), image.mimeType());

            savePortrait(projectId, character.getId(), relativePath);
            done++;
            updateProgress(projectId, step.getId(), done, total);
            log.info("Portrait {}/{} saved for {}", done, total, character.getName());
        }

        // The last image interaction is the anchor for Step 5 (chapter illustrations).
        saveCharactersImageInteraction(projectId, previous);
        completeStep(projectId, step.getId(),
                Map.of("portraits", done),
                "{\"portraits\": " + done + "}");
    }

    // ------------------------------------------------------------------
    // Step 4 — Chapters (structured output, max 1)
    // ------------------------------------------------------------------

    private void runChaptersStep(Long projectId, PipelineStep step) {
        Project project = loadProject(projectId);
        if (project.getCharactersInteractionId() == null) {
            throw new IllegalStateException("Characters step has not succeeded; cannot generate chapters.");
        }

        String prompt = """
                Now, for each chapters of the book, give me a prompt to illustrate what happens in it. \
                It should be a single image, not a multi-tiled page. Be very descriptive, especially of the \
                characters. Be very descriptive and remember to tell their name and to reuse the character \
                prompts if they appear in the images. Also list all characters who appear in it.""";
        GeminiClient.GeminiInteraction interaction = geminiClient.createTextInteraction(
                prompt, project.getCharactersInteractionId(), geminiClient.promptArraySchema());

        List<Map<String, String>> parsed = parseNamePromptArray(interaction.outputText());
        // Server-side cap.
        List<Map<String, String>> capped = parsed.size() > MAX_CHAPTERS
                ? new ArrayList<>(parsed.subList(0, MAX_CHAPTERS))
                : parsed;
        if (capped.isEmpty()) {
            throw new IllegalStateException("Gemini returned no chapter prompts.");
        }

        saveChapters(projectId, interaction.id(), capped);

        completeStep(projectId, step.getId(),
                Map.of("count", capped.size()),
                objectMapper.valueToTree(capped).toString());
    }

    // ------------------------------------------------------------------
    // Step 5 — Illustrations (reuses portrait conversation for consistency)
    // ------------------------------------------------------------------

    private void runIllustrationsStep(Long projectId, PipelineStep step) {
        Project project = loadProject(projectId);
        List<Chapter> chapters = chapterRepository.findByProjectId(projectId);
        if (chapters.isEmpty()) {
            throw new IllegalStateException("No chapters found; run the Chapters step first.");
        }
        if (project.getCharactersImageInteractionId() == null) {
            throw new IllegalStateException("Portraits step has not succeeded; cannot generate illustrations.");
        }

        // Notebook cell 38: continue the image conversation so the model keeps
        // the characters it already drew — that is what keeps them consistent.
        String contextPrompt = """
                Starting from now, we're going to illustrate the book's chapters. Don't forget to refer to \
                your previous illustrations of the characters to keep the characters consistency, but feel \
                free to change their position.""";
        GeminiClient.GeminiInteraction contextInteraction = geminiClient.createImageInteraction(
                contextPrompt, project.getCharactersImageInteractionId());
        String previous = contextInteraction.id();

        int done = 0;
        int total = Math.min(chapters.size(), MAX_CHAPTERS);
        for (int i = 0; i < total; i++) {
            Chapter chapter = chapters.get(i);
            String imagePrompt = """
                    Create an illustration for %s using the previously generated characters following this description: %s"""
                    .formatted(chapter.getName(), chapter.getImagePrompt());
            GeminiClient.GeminiInteraction imageInteraction = geminiClient.createImageInteraction(imagePrompt, previous);
            previous = imageInteraction.id();

            if (imageInteraction.images().isEmpty()) {
                throw new IllegalStateException("Gemini returned no illustration for " + chapter.getName());
            }
            GeminiClient.GeminiImage image = imageInteraction.images().get(0);
            String relativePath = imageStorageService.saveImage(projectId, image.data(), image.mimeType());

            saveIllustration(projectId, chapter.getId(), relativePath);
            done++;
            updateProgress(projectId, step.getId(), done, total);
            log.info("Illustration {}/{} saved for {}", done, total, chapter.getName());
        }

        completeStep(projectId, step.getId(),
                Map.of("illustrations", done),
                "{\"illustrations\": " + done + "}");
    }

    // ------------------------------------------------------------------
    // Helpers (all short transactions; no network calls inside)
    // ------------------------------------------------------------------

    /**
     * Uploads the book and opens the conversation exactly once per project.
     * Whatever these two calls store on the project survives restarts, which is
     * what makes the whole pipeline resumable without re-sending the book text.
     */
    private void ensureBookUploaded(Project project) {
        if (project.getBookInteractionId() == null) {
            String fileUri;
            if (project.getGeminiFileUri() != null) {
                fileUri = project.getGeminiFileUri();
            } else {
                fileUri = geminiClient.uploadBookText(
                        "book-" + project.getId() + ".txt", project.getBookText());
                saveFileUri(project.getId(), fileUri);
            }
            GeminiClient.GeminiInteraction bookInteraction = geminiClient.createBookInteraction(fileUri);
            saveBookInteraction(project.getId(), bookInteraction.id());
        }
    }

    @Transactional
    protected void saveFileUri(Long projectId, String fileUri) {
        projectRepository.findById(projectId).ifPresent(p -> {
            p.setGeminiFileUri(fileUri);
            projectRepository.save(p);
        });
    }

    @Transactional
    protected void saveBookInteraction(Long projectId, String interactionId) {
        projectRepository.findById(projectId).ifPresent(p -> {
            p.setBookInteractionId(interactionId);
            projectRepository.save(p);
        });
    }

    @Transactional
    protected void saveStyle(Long projectId, String interactionId, String style) {
        projectRepository.findById(projectId).ifPresent(p -> {
            p.setStyleInteractionId(interactionId);
            p.setStyle(style);
            projectRepository.save(p);
        });
    }

    @Transactional
    protected void saveCharacters(Long projectId, String interactionId, List<Map<String, String>> characters) {
        projectRepository.findById(projectId).ifPresent(p -> {
            p.setCharactersInteractionId(interactionId);
            projectRepository.save(p);
        });
        characterRepository.deleteByProjectId(projectId); // clean retries
        List<com.gradion.backend.model.Character> entities = new ArrayList<>();
        for (int i = 0; i < characters.size(); i++) {
            entities.add(com.gradion.backend.model.Character.builder()
                    .project(projectRepository.getReferenceById(projectId))
                    .name(characters.get(i).get("name"))
                    .imagePrompt(characters.get(i).get("prompt"))
                    .displayOrder(i)
                    .build());
        }
        characterRepository.saveAll(entities);
    }

    @Transactional
    protected void savePortrait(Long projectId, Long characterId, String relativePath) {
        characterRepository.findById(characterId).ifPresent(c -> {
            c.setPortraitPath(relativePath);
            characterRepository.save(c);
        });
    }

    @Transactional
    protected void saveCharactersImageInteraction(Long projectId, String interactionId) {
        projectRepository.findById(projectId).ifPresent(p -> {
            p.setCharactersImageInteractionId(interactionId);
            projectRepository.save(p);
        });
    }

    @Transactional
    protected void saveChapters(Long projectId, String interactionId, List<Map<String, String>> chapters) {
        projectRepository.findById(projectId).ifPresent(p -> {
            p.setChaptersInteractionId(interactionId);
            projectRepository.save(p);
        });
        chapterRepository.deleteByProjectId(projectId); // clean retries
        List<Chapter> entities = new ArrayList<>();
        for (Map<String, String> chapter : chapters) {
            entities.add(Chapter.builder()
                    .project(projectRepository.getReferenceById(projectId))
                    .name(chapter.get("name"))
                    .imagePrompt(chapter.get("prompt"))
                    .build());
        }
        chapterRepository.saveAll(entities);
    }

    @Transactional
    protected void saveIllustration(Long projectId, Long chapterId, String relativePath) {
        chapterRepository.findById(chapterId).ifPresent(c -> {
            c.setIllustrationPath(relativePath);
            chapterRepository.save(c);
        });
    }

    @Transactional
    protected void updateProgress(Long projectId, Long stepId, int done, int total) {
        pipelineStepRepository.findById(stepId).ifPresent(s -> {
            s.setProgressJson("{\"done\": " + done + ", \"total\": " + total + "}");
            pipelineStepRepository.save(s);
        });
    }

    @Transactional
    protected void completeStep(Long projectId, Long stepId, Map<String, Object> summary, String resultJson) {
        pipelineStepRepository.findById(stepId).ifPresent(s -> {
            s.setStatus("DONE");
            s.setCompletedAt(LocalDateTime.now());
            s.setResultJson(resultJson);
            s.setProgressJson(null);
            pipelineStepRepository.save(s);
        });
        projectRepository.findById(projectId).ifPresent(p -> {
            p.setOverallStatus(allStepsDone(p) ? "DONE" : "IN_PROGRESS");
            projectRepository.save(p);
        });
    }

    @Transactional
    protected void failStep(Long projectId, int stepNumber, String errorMessage) {
        pipelineStepRepository.findByProjectIdAndStepNumber(projectId, stepNumber).ifPresent(s -> {
            s.setStatus("FAILED");
            s.setCompletedAt(LocalDateTime.now());
            s.setResultJson("{\"error\": " + jsonString(errorMessage) + "}");
            pipelineStepRepository.save(s);
        });
        projectRepository.findById(projectId).ifPresent(p -> {
            p.setOverallStatus("IN_PROGRESS");
            projectRepository.save(p);
        });
    }

    private Project loadProject(Long projectId) {
        return projectRepository.findById(projectId)
                .orElseThrow(() -> new IllegalStateException("Project not found: " + projectId));
    }

    private boolean allStepsDone(Project project) {
        List<PipelineStep> steps = pipelineStepRepository.findByProjectIdOrderByStepNumber(project.getId());
        return steps.size() == 5 && steps.stream().allMatch(s -> "DONE".equals(s.getStatus()));
    }

    private List<Map<String, String>> parseNamePromptArray(String json) {
        try {
            JsonNode node = objectMapper.readTree(json);
            if (node != null && node.isArray()) {
                return objectMapper.convertValue(node, new TypeReference<List<Map<String, String>>>() {});
            }
            // Some responses wrap the array (e.g. a single object or nested field).
            throw new IllegalStateException("Gemini returned unexpected JSON: " + json);
        } catch (Exception e) {
            throw new IllegalStateException("Cannot parse Gemini characters/chapters JSON: " + json, e);
        }
    }

    private String jsonString(String value) {
        try {
            return objectMapper.writeValueAsString(value);
        } catch (Exception e) {
            return "{}";
        }
    }
}